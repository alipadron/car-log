{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "laravel-boost": {
      "type": "local",
      "enabled": true,
      "command": ["php", "api/artisan", "boost:mcp"]
    },
    "angular-cli": {
      "type": "local",
      "enabled": true,
      "command": ["node", "web/node_modules/@angular/cli/bin/ng.js", "mcp"]
    },
    "spartan-ui": {
      "type": "local",
      "enabled": true,
      "command": ["node", "web/node_modules/@spartan-ng/mcp/src/server.js"]
    }
  }
}