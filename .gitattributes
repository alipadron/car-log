# Normalize line endings so the deploy/container files stay LF even on
# Windows checkouts. entrypoint.sh, nginx.conf, php-fpm and supervisord
# configs run inside Linux containers — CRLF would break them.
* text=auto

*.sh  text eol=lf
*.conf text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
*.ps1 text eol=lf
