# car-log deploy configuration. Copy to deploy/.env (or run deploy/setup.ps1,
# the wizard, which walks you through generating every value).

# Subdomain of alipadron.dev the app is reachable at, e.g. carlog →
# https://carlog.alipadron.dev
CAR_LOG_SUBDOMAIN=

# The single password that unlocks the app.
CAR_LOG_UNLOCK_PASSWORD=

# Laravel app key (base64: prefix included). Generate with:
#   php artisan key:generate --show
APP_KEY=

# Cloudflare Tunnel token (from the tunnel's dashboard / `cloudflared tunnel
# token <name>` — see the wizard). The tunnel must have a public hostname
# <subdomain>.alipadron.dev → http://localhost:80.
CLOUDFLARE_TUNNEL_TOKEN=

# Optional, Linux only: set to a host path (e.g. ./data) to store the SQLite
# file as a bind mount you can copy directly. Leave empty on Windows — the
# default Docker named volume keeps SQLite's file locking reliable under
# Docker Desktop. See README "Backups".
# CAR_LOG_DATA_VOLUME=